{#
  One neighborhood guide as a card — shared by the /neighborhoods/ index and
  the homepage's "Explore Las Cruces Neighborhoods" section so the two don't
  drift apart. `guide` is an item from collections.neighborhoods; `level` is
  the card title's heading level (3 under a section h2, 2 directly under h1).
#}
{% from "macros/bilingual.njk" import bilingual %}
{% macro neighborhoodCard(guide, level=3) %}
<div class="service-card neighborhood-card">
  {% if guide.data.image %}<img src="{{ guide.data.image }}" alt="" class="neighborhood-card__image" loading="lazy" decoding="async">{% endif %}
  <h{{ level }}><a href="{{ guide.url }}" class="neighborhood-card__link">{{ bilingual(guide.data.title, guide.data.titleEs) }}</a></h{{ level }}>
  <p>{{ bilingual(guide.data.summary, guide.data.summaryEs) }}</p>
  <p class="neighborhood-card__more" aria-hidden="true" data-i18n="nbhd.readGuide">Read the guide →</p>
</div>
{% endmacro %}
