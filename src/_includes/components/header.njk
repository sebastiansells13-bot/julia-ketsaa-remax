<header class="site-header">
  <div class="wrapper">
    <a class="site-header__brand" href="/">
      <span class="remax-wordmark"><span class="remax-wordmark__re">RE</span>/<span class="remax-wordmark__max">MAX</span></span>
      <span class="site-header__agent">{{ business.name or metadata.title }}</span>
    </a>
    <nav>
      <ul>
        {% for item in navigation %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} class="is-active" aria-current="page"{% endif %}>{{ item.text }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
