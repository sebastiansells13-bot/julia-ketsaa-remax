{% from "macros/bilingual.njk" import bilingual %}
<section class="newsletter">
  <div class="wrapper">
    <div class="newsletter__inner">
      <div>
        <h2 data-i18n="newsletter.heading">Stay in the loop</h2>
        <p data-i18n="newsletter.subtext">New listings and Las Cruces market updates — no spam, unsubscribe anytime.</p>
      </div>
      {% include "components/newsletter-form.njk" %}
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="wrapper">
    <div class="site-footer__legal">
      <div class="equal-housing">
        {% include "components/equal-housing-icon.njk" %}
        <span data-i18n="equalhousing.label">Equal Housing Opportunity</span>
      </div>
      <p class="site-footer__disclaimer">{{ bilingual(business.disclaimer, business.disclaimerEs) }}</p>
    </div>

    {% if business.social and (business.social.instagram or business.social.facebook or business.social.linkedin) %}
    {#
      business.social.* is CMS-editable (.pages.yml "Social Links") but
      starts empty, so this renders nothing until Julia actually fills one
      in. Platform names are proper nouns — same in English and Spanish —
      so no data-i18n here, same treatment as the business name.
    #}
    <nav class="site-footer__social" aria-label="Follow Julia Ketsaa">
      {% if business.social.instagram %}<a href="{{ business.social.instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a>{% endif %}
      {% if business.social.facebook %}<a href="{{ business.social.facebook }}" target="_blank" rel="noopener noreferrer">Facebook</a>{% endif %}
      {% if business.social.linkedin %}<a href="{{ business.social.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>{% endif %}
    </nav>
    {% endif %}

    <div class="site-footer__bottom">
      <span>&copy; {% year %} {{ business.name or metadata.title }}, {{ business.title }}</span>
      <span>
        {% if business.email %}<a href="mailto:{{ business.email }}">{{ business.email }}</a>{% endif %}
        {% if business.phoneCell %} · <span data-i18n="contact.cell">Cell</span> {{ business.phoneCell }}{% endif %}
        {% if business.phoneOffice %} · <span data-i18n="contact.office">Office</span> {{ business.phoneOffice }}{% endif %}
      </span>
    </div>
    {% if business.phoneOffice %}
    <p class="site-footer__a11y-note"><span data-i18n="footer.a11yNotePre">Need help navigating this website or searching for real estate? Call our office at</span> <a href="tel:{{ business.phoneOffice }}">{{ business.phoneOffice }}</a>.</p>
    {% endif %}
    <nav class="site-footer__links" aria-label="More pages">
      <a href="/home-value/" data-i18n="footer.homevalue">What's My Home Worth?</a>
      <a href="/faq/" data-i18n="footer.faq">FAQ</a>
      <a href="/fair-housing/" data-i18n="footer.fairhousing">Fair Housing</a>
      <a href="/accessibility/" data-i18n="footer.accessibility">Accessibility</a>
      <a href="/privacy/" data-i18n="footer.privacy">Privacy</a>
    </nav>
  </div>
</footer>
