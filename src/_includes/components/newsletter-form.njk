<form class="newsletter-form" id="newsletter-form" data-endpoint="NEWSLETTER_ENDPOINT_NOT_CONFIGURED" method="post">
  <label for="newsletter-email" class="sr-only">Email address</label>
  <input type="email" id="newsletter-email" name="email" placeholder="you@example.com" required>
  <button type="submit">Subscribe</button>
  <p class="newsletter-form__status" id="newsletter-status" role="status" aria-live="polite"></p>
</form>
