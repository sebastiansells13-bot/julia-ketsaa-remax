{#
  "Schedule a Tour" lead-capture form for a listing detail page. Caller
  must have `listing` in scope (true on listing-detail.njk, which aliases
  the paginated item to `listing`). Submits via the shared
  src/_includes/js/lead-form.js handler — see AGENTS.md's "Lead-capture
  forms" note before duplicating any of its validate/submit/honesty logic.
#}
<div class="listing-detail__tour" id="schedule-tour">
  <h2 data-i18n="tour.heading">Schedule a Tour</h2>
  <form
    class="contact-form"
    id="tour-form"
    data-lead-form
    data-endpoint="TOUR_REQUEST_ENDPOINT_NOT_CONFIGURED"
    data-not-connected-key="tour.notConnected"
    data-success-key="tour.success"
    data-message-vars="{{ {"address": listing.address} | dump }}"
    method="post"
  >
    <input type="hidden" name="listing" value="{{ listing.address }}, {{ listing.location }}">
    <fieldset class="contact-form__row tour-form__type">
      <legend data-i18n="tour.type">Tour Type</legend>
      <div class="tour-form__type-options">
        <label class="tour-form__radio"><input type="radio" name="tourType" value="In-Person" checked> <span data-i18n="tour.inPerson">In-Person</span></label>
        <label class="tour-form__radio"><input type="radio" name="tourType" value="Virtual"> <span data-i18n="tour.virtual">Virtual</span></label>
      </div>
    </fieldset>
    <div class="contact-form__row">
      <label for="tour-date" data-i18n="tour.preferredDate">Preferred Date</label>
      <input type="date" id="tour-date" name="preferredDate" required>
    </div>
    <div class="contact-form__row">
      <label for="tour-time" data-i18n="tour.preferredTime">Preferred Time</label>
      <select id="tour-time" name="preferredTime">
        <option value="Morning" data-i18n="tour.morning">Morning</option>
        <option value="Afternoon" data-i18n="tour.afternoon">Afternoon</option>
        <option value="Evening" data-i18n="tour.evening">Evening</option>
      </select>
    </div>
    <div class="contact-form__row">
      <label for="tour-name" data-i18n="form.name">Name</label>
      <input type="text" id="tour-name" name="name" autocomplete="name" required>
    </div>
    <div class="contact-form__row">
      <label for="tour-email" data-i18n="form.email">Email</label>
      <input type="email" id="tour-email" name="email" autocomplete="email" required>
    </div>
    <div class="contact-form__row">
      <label for="tour-phone"><span data-i18n="form.phone">Phone</span> <span class="contact-form__optional" data-i18n="form.optional">(optional)</span></label>
      <input type="tel" id="tour-phone" name="phone" autocomplete="tel">
    </div>
    <div class="contact-form__row">
      <label for="tour-message"><span data-i18n="form.anythingElse">Anything else?</span> <span class="contact-form__optional" data-i18n="form.optional">(optional)</span></label>
      <textarea id="tour-message" name="message" rows="3"></textarea>
    </div>
    <button type="submit" data-i18n="tour.button">Schedule a Tour</button>
    <p class="contact-form__status" data-lead-form-status role="status" aria-live="polite"></p>
  </form>
</div>
