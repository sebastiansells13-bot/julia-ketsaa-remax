{#
  Deliberately NOT also a .wrapper: .contact-form has its own (narrower)
  max-width for readability, and combining that with .wrapper's margin:
  0 auto centering would center this form independently of — and
  misaligned with — whatever heading/wrapper sits above it on the page.
  This div is the .wrapper instead, so the form just hugs its left edge.
#}
<div class="wrapper">
  <form
    class="contact-form"
    id="contact-form"
    data-lead-form
    data-endpoint="CONTACT_FORM_ENDPOINT_NOT_CONFIGURED"
    data-not-connected-key="contactform.notConnected"
    data-success-key="contactform.success"
    method="post"
  >
    <div class="contact-form__row">
      <label for="contact-name" data-i18n="form.name">Name</label>
      <input type="text" id="contact-name" name="name" autocomplete="name" required>
    </div>
    <div class="contact-form__row">
      <label for="contact-email" data-i18n="form.email">Email</label>
      <input type="email" id="contact-email" name="email" autocomplete="email" required>
    </div>
    <div class="contact-form__row">
      <label for="contact-phone"><span data-i18n="form.phone">Phone</span> <span class="contact-form__optional" data-i18n="form.optional">(optional)</span></label>
      <input type="tel" id="contact-phone" name="phone" autocomplete="tel">
    </div>
    <div class="contact-form__row">
      <label for="contact-message" data-i18n="form.message">Message</label>
      <textarea id="contact-message" name="message" rows="5" required></textarea>
    </div>
    <button type="submit" data-i18n="contact.sendMessageButton">Send Message</button>
    <p class="contact-form__status" data-lead-form-status role="status" aria-live="polite"></p>
  </form>
</div>
