{%- set pageTitle = (title + " · " + (business.name or metadata.title)) if title else (business.name or metadata.title) -%}
{%- set pageDescription = description or business.tagline or metadata.description -%}
{%- set pageUrl = siteUrl + page.url -%}
{%- set socialImage = siteUrl + (business.photo or "/img/hero/realty-hero.jpg") -%}
<!doctype html>
<html lang="{{ metadata.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ pageUrl }}">
  <link rel="stylesheet" href="{{ assetPaths.stylesheet }}">
  {% if collections %}<link rel="alternate" href="/feed.xml" type="application/atom+xml" title="{{ business.name }}">{% endif %}

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ business.name or metadata.title }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ socialImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ socialImage }}">

  <script type="application/ld+json">{{ business | businessSchema(siteUrl) | safe }}</script>
</head>
<body>
  {% include "components/header.njk" %}
  <main>
    {{ content | safe }}
  </main>
  {% include "components/footer.njk" %}
  <script src="/js/newsletter.js" defer></script>
</body>
</html>
