{%- set pageTitle = (title + " · " + (business.name or metadata.title)) if title else (business.name or metadata.title) -%}
{%- set pageDescription = description or business.tagline or metadata.description -%}
{%- set pageUrl = siteUrl + page.url -%}
{%- set socialImage = siteUrl + (business.photo or "/img/hero/realty-hero.jpg") -%}
<!doctype html>
<html lang="{{ metadata.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ pageUrl }}">
  {% if noindex or listing.isSample %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="stylesheet" href="{{ assetPaths.stylesheet }}">
  {% if collections %}<link rel="alternate" href="/feed.xml" type="application/atom+xml" title="{{ business.name }}">{% endif %}

  <link rel="icon" href="/favicons/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicons/favicon-32x32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicons/favicon-16x16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ business.name or metadata.title }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ socialImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ socialImage }}">

  <script type="application/ld+json">{{ business | businessSchema(siteUrl) | safe }}</script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  {% include "components/header.njk" %}
  <main id="main-content">
    {{ content | safe }}
  </main>
  {% include "components/footer.njk" %}
  {#
    Every listing (with a precomputed slug) as plain JSON, for client-side
    scripts that need to look up listing details from a slug in
    localStorage (recently-viewed, compare) without a page reload. Not
    application/ld+json — this is data for our own scripts, not structured
    data for crawlers.
  #}
  <script type="application/json" id="listings-data">{{ listings.list | listingsWithSlugs | dump | safe }}</script>
  <script>window.SITE_BASE = "{{ sitePathPrefix }}";</script>
  <script src="/js/nav.js" defer></script>
  <script src="/js/newsletter.js" defer></script>
  <script src="/js/saved-listings.js" defer></script>
  <script src="/js/listings-filter.js" defer></script>
  <script src="/js/mortgage-calculator.js" defer></script>
  <script src="/js/lead-form.js" defer></script>
  <script src="/js/recently-viewed.js" defer></script>
  <script src="/js/compare.js" defer></script>
  <script src="/js/share-listing.js" defer></script>
  <script src="/js/gallery.js" defer></script>
</body>
</html>
