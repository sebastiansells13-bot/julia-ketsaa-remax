---
layout: layouts/base.njk
---
<article class="wrapper post">
  <h1>{{ title }}</h1>
  <time datetime="{{ date | htmlDateString }}" data-i18n-date>{{ date | readableDate }}</time>
  {% if image %}<img src="{{ image }}" alt="">{% endif %}
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
