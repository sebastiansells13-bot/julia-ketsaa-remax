---
layout: layouts/page.njk
title: Listings
permalink: /listings/
---
{% from "macros/listing-placeholder.njk" import listingPlaceholder %}
<div class="wrapper">
  <h1>Current Listings</h1>
  {% if listings.list.length %}
  <div class="listings-toolbar" id="listings-toolbar">
    <div class="listings-toolbar__field">
      <label for="filter-status">Status</label>
      <select id="filter-status">
        <option value="all">All statuses</option>
        <option value="for-sale">For Sale</option>
        <option value="pending">Pending</option>
        <option value="sold">Sold</option>
      </select>
    </div>
    <div class="listings-toolbar__field">
      <label for="filter-beds">Min. beds</label>
      <select id="filter-beds">
        <option value="0">Any</option>
        <option value="1">1+</option>
        <option value="2">2+</option>
        <option value="3">3+</option>
        <option value="4">4+</option>
      </select>
    </div>
    <div class="listings-toolbar__field">
      <label for="filter-baths">Min. baths</label>
      <select id="filter-baths">
        <option value="0">Any</option>
        <option value="1">1+</option>
        <option value="1.5">1.5+</option>
        <option value="2">2+</option>
        <option value="2.5">2.5+</option>
        <option value="3">3+</option>
      </select>
    </div>
    <div class="listings-toolbar__field">
      <label for="sort-listings">Sort by</label>
      <select id="sort-listings">
        <option value="default">Featured</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
        <option value="beds-desc">Beds: Most to Fewest</option>
        <option value="baths-desc">Baths: Most to Fewest</option>
        <option value="sqft-desc">Sqft: Largest to Smallest</option>
      </select>
    </div>
  </div>
  {% endif %}
</div>
<section class="listings-grid wrapper" id="listings-grid">
  {% for listing in listings.list %}
  <a class="listing-card" href="/listings/{{ listing.address | slugify }}/" data-status="{{ listing.status | slugify }}" data-beds="{{ listing.beds }}" data-baths="{{ listing.baths }}" data-sqft="{{ listing.sqft }}" data-price="{{ listing.price }}">
    <div class="listing-card__media">
      {% if listing.image %}
      <img src="{{ listing.image }}" alt="">
      {% else %}
      {{ listingPlaceholder(loop.index0) }}
      {% endif %}
      <span class="listing-card__status listing-card__status--{{ listing.status | slugify }}">{{ listing.status }}</span>
      {% if listing.isSample %}<span class="listing-card__sample">Sample</span>{% endif %}
    </div>
    <div class="listing-card__body">
      <p class="listing-card__price">{{ listing.price }}</p>
      <h3>{{ listing.address }}</h3>
      <p class="listing-card__location">{{ listing.location }}</p>
      <p class="listing-card__stats">{{ listing.beds }} bed · {{ listing.baths }} bath · {{ listing.sqft }} sqft</p>
      <p>{{ listing.blurb }}</p>
    </div>
  </a>
  {% else %}
  <p>No active listings right now — <a href="/contact/">get in touch</a> and Julia can fill you in on what's coming up.</p>
  {% endfor %}
</section>
{% if listings.list.length %}
<p class="listings-empty wrapper" id="listings-empty" hidden>No listings match your filters — <a href="/contact/">contact Julia</a> or try adjusting them.</p>
{% endif %}
