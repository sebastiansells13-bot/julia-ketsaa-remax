---
layout: layouts/page.njk
title: Contact
permalink: /contact/
---
<div class="wrapper">
  <h1>Contact</h1>
  <p>Thinking about buying or selling in the Las Cruces area? Reach out for a no-obligation conversation.</p>
</div>
<dl class="contact-details wrapper">
  {% if business.phoneCell %}
  <dt>Cell</dt>
  <dd><a href="tel:{{ business.phoneCell }}">{{ business.phoneCell }}</a></dd>
  {% endif %}
  {% if business.phoneOffice %}
  <dt>Office</dt>
  <dd><a href="tel:{{ business.phoneOffice }}">{{ business.phoneOffice }}</a></dd>
  {% endif %}
  {% if business.email %}
  <dt>Email</dt>
  <dd><a href="mailto:{{ business.email }}">{{ business.email }}</a></dd>
  {% endif %}
  {% if business.address %}
  <dt>Office Address</dt>
  <dd>{{ business.address }}</dd>
  {% endif %}
</dl>
<p class="wrapper agent-bio__license">{{ business.license }}<br>{{ business.disclaimer }}</p>

<div class="wrapper">
  <h2>Send a Message</h2>
</div>
{% include "components/contact-form.njk" %}
