---
layout: layouts/page.njk
title: What's My Home Worth?
description: Get a free, no-obligation home value estimate from Julia Ketsaa.
permalink: /home-value/
---
<div class="wrapper">
  <h1>What's My Home Worth?</h1>
  <p>A free comparative market analysis — real numbers based on recent sales near you, no obligation.</p>
</div>
<div class="wrapper">
  <form
    class="contact-form"
    id="home-value-form"
    data-lead-form
    data-endpoint="HOME_VALUE_ENDPOINT_NOT_CONFIGURED"
    data-not-connected-message="Thanks! This form isn't connected yet — please call, text, or email Julia directly and she'll get started on your estimate."
    data-success-message="Request sent — Julia will follow up with your estimate soon."
    method="post"
  >
    <div class="contact-form__row">
      <label for="hv-name">Name</label>
      <input type="text" id="hv-name" name="name" autocomplete="name" required>
    </div>
    <div class="contact-form__row">
      <label for="hv-email">Email</label>
      <input type="email" id="hv-email" name="email" autocomplete="email" required>
    </div>
    <div class="contact-form__row">
      <label for="hv-phone">Phone <span class="contact-form__optional">(optional)</span></label>
      <input type="tel" id="hv-phone" name="phone" autocomplete="tel">
    </div>
    <div class="contact-form__row">
      <label for="hv-address">Property Address</label>
      <input type="text" id="hv-address" name="address" autocomplete="street-address" required>
    </div>
    <div class="contact-form__row">
      <label for="hv-timeframe">Timeframe</label>
      <select id="hv-timeframe" name="timeframe">
        <option value="just-curious">Just curious</option>
        <option value="asap">Ready to sell ASAP</option>
        <option value="1-3-months">1–3 months</option>
        <option value="3-6-months">3–6 months</option>
        <option value="6-plus-months">6+ months</option>
      </select>
    </div>
    <div class="contact-form__row">
      <label for="hv-message">Anything else? <span class="contact-form__optional">(optional)</span></label>
      <textarea id="hv-message" name="message" rows="4"></textarea>
    </div>
    <button type="submit">Get My Free Estimate</button>
    <p class="contact-form__status" data-lead-form-status role="status" aria-live="polite"></p>
  </form>
</div>
