---
layout: layouts/page.njk
title: About
permalink: /about/
---
<div class="wrapper agent-bio">
  <h1><span data-i18n="about.prefix">About</span> {{ business.name }}</h1>
  <div class="agent-bio__layout{% if not business.photo %} agent-bio__layout--no-photo{% endif %}">
    {% if business.photo %}<img src="{{ business.photo }}" alt="{{ business.name }}" class="agent-bio__photo" loading="lazy" decoding="async">{% endif %}
    <div>
      <p class="agent-bio__title">{{ business.title }}</p>
      <p>{{ business.bio | safe }}</p>
      <p class="agent-bio__license">{{ business.license }}{% if business.licenseNumber %} · License #{{ business.licenseNumber }}{% endif %}<br>{{ business.disclaimer }}</p>
    </div>
  </div>
</div>
