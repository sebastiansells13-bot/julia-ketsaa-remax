---
layout: layouts/page.njk
title: About
permalink: /about/
description: "Meet Julia Ketsaa, REALTOR® Associate Broker with RE/MAX Classic Realty, bringing local Las Cruces knowledge and personal attention to every buyer and seller."
---
{% from "macros/bilingual.njk" import bilingual %}
<div class="wrapper agent-bio">
  <h1><span data-i18n="about.prefix">About</span> {{ business.name }}</h1>
  <div class="agent-bio__layout{% if not business.photo %} agent-bio__layout--no-photo{% endif %}">
    {% if business.photo %}<img src="{{ business.photo }}" alt="{{ business.name }}" class="agent-bio__photo" loading="lazy" decoding="async">{% endif %}
    <div>
      <p class="agent-bio__title">{{ business.title }}</p>
      <p>{{ bilingual(business.bio, business.bioEs, "span", true) }}</p>
      <p class="agent-bio__license">{{ business.license }}{% if business.licenseNumber %} · License #{{ business.licenseNumber }}{% endif %}<br>{{ bilingual(business.disclaimer, business.disclaimerEs) }}</p>
    </div>
  </div>
</div>
<div class="wrapper cta-banner">
  <div>
    <h2 data-i18n="about.ctaHeading">Ready to talk about your next move?</h2>
    <p data-i18n="about.ctaText">Buying or selling, Julia is happy to start with a no-obligation conversation.</p>
  </div>
  <a href="/contact/" class="cta-banner__button" data-i18n="home.heroContact">Contact Julia</a>
</div>
