---
layout: layouts/page.njk
title: About
permalink: /about/
---
<div class="wrapper agent-bio">
  <h1>About {{ business.name }}</h1>
  <div class="agent-bio__layout{% if not business.photo %} agent-bio__layout--no-photo{% endif %}">
    {% if business.photo %}<img src="{{ business.photo }}" alt="{{ business.name }}" class="agent-bio__photo">{% endif %}
    <div>
      <p class="agent-bio__title">{{ business.title }}</p>
      <p>{{ business.bio | safe }}</p>
      <p class="agent-bio__license">{{ business.license }}<br>{{ business.disclaimer }}</p>
    </div>
  </div>
</div>
