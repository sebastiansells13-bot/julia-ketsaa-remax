---
layout: layouts/page.njk
title: Home
eleventyNavigation:
  key: Home
  order: 1
---
{% from "macros/listing-card.njk" import listingCard %}
{% from "macros/bilingual.njk" import bilingual %}
<div class="hero hero--photo">
  <img class="hero__bg" src="/img/hero/realty-hero.jpg" alt="" width="1920" height="900">
  <div class="hero__content wrapper">
    <h1>{{ business.name }}</h1>
    <p class="hero__title">{{ business.title }}</p>
    <p>{{ bilingual(business.tagline, business.taglineEs) }}</p>
  </div>
</div>

<section class="wrapper">
  <div class="section-heading">
    <h2 data-i18n="home.featuredListings">Featured Listings</h2>
    <a href="/listings/" data-i18n="home.viewAllListings">View all listings →</a>
  </div>
</section>
<section class="listings-grid wrapper">
  {% for listing in listings.list | head(3) %}
  {{ listingCard(listing, { showSave: true, showNewTag: true, showOpenHouse: true, placeholderSeed: loop.index0 }) }}
  {% else %}
  <p><span data-i18n="home.newListingsPre">New listings are on the way —</span> <a href="/contact/" data-i18n="home.reachOut">reach out</a> <span data-i18n="home.newListingsPost">for what's currently available.</span></p>
  {% endfor %}
</section>

<section class="services-grid wrapper">
  {% for service in services.list %}
  <div class="service-card">
    {% if service.icon %}<img src="{{ service.icon }}" alt="" class="service-card__icon" loading="lazy" decoding="async">{% endif %}
    <h3>{{ service.title }}</h3>
    <p>{{ service.description }}</p>
  </div>
  {% endfor %}
</section>

{% if testimonials.list.length %}
<section class="testimonials wrapper">
  <h2 data-i18n="home.whatClientsSay">What Clients Say</h2>
  <div class="testimonials-grid">
    {% for t in testimonials.list %}
    <blockquote class="testimonial">
      <p>&ldquo;{{ t.quote }}&rdquo;</p>
      <cite>— {{ t.name }}</cite>
    </blockquote>
    {% endfor %}
  </div>
</section>
{% endif %}
