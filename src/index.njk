---
layout: layouts/page.njk
title: Home
eleventyNavigation:
  key: Home
  order: 1
---
{% from "macros/listing-placeholder.njk" import listingPlaceholder %}
<div class="hero hero--photo">
  <img class="hero__bg" src="/img/hero/realty-hero.jpg" alt="" width="1920" height="900">
  <div class="hero__content wrapper">
    <h1>{{ business.name }}</h1>
    <p class="hero__title">{{ business.title }}</p>
    <p>{{ business.tagline }}</p>
  </div>
</div>

<section class="wrapper">
  <div class="section-heading">
    <h2 data-i18n="home.featuredListings">Featured Listings</h2>
    <a href="/listings/" data-i18n="home.viewAllListings">View all listings →</a>
  </div>
</section>
<section class="listings-grid wrapper">
  {% for listing in listings.list | head(3) %}
  {% set slug = listing.address | slugify %}
  <div class="listing-card" data-slug="{{ slug }}">
    <a class="listing-card__link" href="/listings/{{ slug }}/" aria-label="View details for {{ listing.address }}"></a>
    <div class="listing-card__media">
      {% if listing.image %}
      <img src="{{ listing.image }}" alt="{{ listing.address }}" loading="lazy" decoding="async">
      {% else %}
      {{ listingPlaceholder(loop.index0) }}
      {% endif %}
      <span class="listing-card__status listing-card__status--{{ listing.status | slugify }}" data-i18n="status.{{ listing.status | slugify }}">{{ listing.status }}</span>
      {% if listing.isSample %}<span class="listing-card__sample" data-i18n="listings.sampleBadge">Sample</span>{% endif %}
      <button type="button" class="listing-card__save" data-save-toggle data-slug="{{ slug }}" data-label="{{ listing.address }}" aria-pressed="false">
        {% include "components/star-icon.njk" %}
      </button>
    </div>
    <div class="listing-card__body">
      <p class="listing-card__price">{{ listing.price }}{% if listing.justListed %} <span class="listing-card__new-tag" data-i18n="listings.newTag">New</span>{% endif %}</p>
      <h3>{{ listing.address }}</h3>
      <p class="listing-card__stats">{{ listing.beds }} bed · {{ listing.baths }} bath · {{ listing.sqft }} sqft</p>
      {% if listing.openHouse %}<p class="listing-card__openhouse"><span data-i18n="listingdetail.openHousePrefix">🏠 Open House:</span> {{ listing.openHouse }}</p>{% endif %}
    </div>
  </div>
  {% else %}
  <p><span data-i18n="home.newListingsPre">New listings are on the way —</span> <a href="/contact/" data-i18n="home.reachOut">reach out</a> <span data-i18n="home.newListingsPost">for what's currently available.</span></p>
  {% endfor %}
</section>

<section class="services-grid wrapper">
  {% for service in services.list %}
  <div class="service-card">
    {% if service.icon %}<img src="{{ service.icon }}" alt="" class="service-card__icon" loading="lazy" decoding="async">{% endif %}
    <h3>{{ service.title }}</h3>
    <p>{{ service.description }}</p>
  </div>
  {% endfor %}
</section>

{% if testimonials.list.length %}
<section class="testimonials wrapper">
  <h2 data-i18n="home.whatClientsSay">What Clients Say</h2>
  <div class="testimonials-grid">
    {% for t in testimonials.list %}
    <blockquote class="testimonial">
      <p>&ldquo;{{ t.quote }}&rdquo;</p>
      <cite>— {{ t.name }}</cite>
    </blockquote>
    {% endfor %}
  </div>
</section>
{% endif %}
