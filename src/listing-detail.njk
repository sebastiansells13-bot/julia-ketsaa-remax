---
pagination:
  data: listings.list
  size: 1
  alias: listing
permalink: "/listings/{{ listing.address | slugify }}/"
eleventyExcludeFromCollections: true
layout: layouts/page.njk
eleventyComputed:
  title: "{{ listing.address }}"
  description: "{{ listing.blurb }}"
---
{% from "macros/listing-placeholder.njk" import listingPlaceholder %}
{% set slug = listing.address | slugify %}
{% set gallery = listing | galleryImages %}
{% set videoEmbedUrl = listing.videoUrl | embedVideoUrl %}
{% set crumbs = [{name: "Home", url: "/"}, {name: "Listings", url: "/listings/"}, {name: listing.address, url: "/listings/" + slug + "/"}] %}
{% set similar = listings.list | similarListings(listing.address, 3) %}
<div class="listing-detail wrapper" data-listing-slug="{{ slug }}">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/" data-i18n="nav.home">Home</a> <span aria-hidden="true">/</span>
    <a href="/listings/" data-i18n="nav.listings">Listings</a> <span aria-hidden="true">/</span>
    <span aria-current="page">{{ listing.address }}</span>
  </nav>

  {% if listing.isSample %}
  <p class="sample-banner"><span data-i18n="listingdetail.sampleBannerPre">This is a sample listing for demonstration — not a real property for sale.</span> <a href="/contact/" data-i18n="listingdetail.contactJulia">Contact Julia</a> <span data-i18n="listingdetail.sampleBannerPost">for current listings.</span></p>
  {% endif %}

  {% if listing.openHouse %}
  <p class="open-house-banner"><span data-i18n="listingdetail.openHousePrefix">🏠 Open House:</span> {{ listing.openHouse }}</p>
  {% endif %}

  <div class="listing-detail__media" id="listing-gallery">
    {% if gallery.length %}
    <button type="button" class="listing-detail__media-main" data-gallery-open aria-label="View larger photo">
      <img src="{{ gallery[0] }}" alt="{{ listing.address }}" data-gallery-main-img>
    </button>
    {% if gallery.length > 1 %}
    <div class="listing-detail__thumbs">
      {% for img in gallery %}
      <button type="button" class="listing-detail__thumb{% if loop.first %} is-active{% endif %}" data-gallery-thumb data-src="{{ img }}" aria-label="Photo {{ loop.index }} of {{ gallery.length }}">
        <img src="{{ img }}" alt="" loading="lazy" decoding="async">
      </button>
      {% endfor %}
    </div>
    {% endif %}
    {% else %}
    {{ listingPlaceholder(pagination.pageNumber) }}
    {% endif %}
    <span class="listing-card__status listing-card__status--{{ listing.status | slugify }}" data-i18n="status.{{ listing.status | slugify }}">{{ listing.status }}</span>
  </div>

  <div class="listing-detail__header">
    <div class="listing-detail__header-row">
      <div>
        <p class="listing-detail__label" data-i18n="listingdetail.addressLabel">Address</p>
        <h1>{{ listing.address }}</h1>
        <p class="listing-detail__location">{{ listing.location }}</p>
      </div>
      <div class="listing-detail__price-block">
        <p class="listing-detail__label" data-i18n="listingdetail.priceLabel">Price</p>
        <p class="listing-detail__price">{{ listing.price }}</p>
      </div>
    </div>
    <div class="listing-detail__header-actions">
      <button type="button" class="listing-card__save listing-card__save--detail" data-save-toggle data-slug="{{ slug }}" data-label="{{ listing.address }}" aria-pressed="false">
        {% include "components/star-icon.njk" %}
        <span data-i18n="listingdetail.save">Save</span>
      </button>
      <button type="button" class="listing-detail__share" data-share-listing data-title="{{ listing.address }}, {{ listing.location }}">
        <span data-i18n="listingdetail.share">Share</span>
      </button>
    </div>
  </div>

  <div class="listing-detail__quick-actions">
    <a href="#ask-about-listing" class="listing-detail__quick-action" data-i18n="listingdetail.askQuestion">Ask a Question</a>
    <a href="#schedule-tour" class="listing-detail__quick-action listing-detail__quick-action--primary" data-i18n="listingdetail.requestShowing">Request a Showing</a>
  </div>

  {% include "components/listing-agent-card.njk" %}

  <dl class="listing-detail__attributes">
    {% if listing.propertyType %}<div><dt data-i18n="listingdetail.propertyType">Property Type</dt><dd data-i18n="propertytype.{{ listing.propertyType | slugify }}">{{ listing.propertyType }}</dd></div>{% endif %}
    <div><dt data-i18n="listings.statusLabel">Status</dt><dd data-i18n="status.{{ listing.status | slugify }}">{{ listing.status }}</dd></div>
    <div><dt data-i18n="listingdetail.priceLabel">Price</dt><dd>{{ listing.price }}</dd></div>
    <div><dt data-i18n="listingdetail.beds">Beds</dt><dd>{{ listing.beds }}</dd></div>
    <div><dt data-i18n="listingdetail.baths">Baths</dt><dd>{{ listing.baths }}</dd></div>
    <div><dt data-i18n="listingdetail.sqft">Sqft</dt><dd>{{ listing.sqft }}</dd></div>
    {% if listing.yearBuilt %}<div><dt data-i18n="listingdetail.yearBuilt">Year Built</dt><dd>{{ listing.yearBuilt }}</dd></div>{% endif %}
    {% if listing.lotSize %}<div><dt data-i18n="listingdetail.lotSize">Lot Size</dt><dd>{{ listing.lotSize }}</dd></div>{% endif %}
  </dl>

  {% if listing.description %}
  <div class="listing-detail__description-wrap">
    <h2 data-i18n="listingdetail.descriptionHeading">Property Description</h2>
    <p class="listing-detail__description">{{ listing.description | safe }}</p>
  </div>
  {% endif %}

  {% if listing.features and listing.features.length %}
  <div class="listing-detail__features">
    <h2 data-i18n="listingdetail.featuresHeading">Features</h2>
    <ul>
      {% for feature in listing.features %}
      <li>{{ feature }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if videoEmbedUrl %}
  <div class="video-embed-wrap">
    <h2 data-i18n="listingdetail.videoTourHeading">Video Tour</h2>
    <div class="video-embed">
      <iframe src="{{ videoEmbedUrl }}" title="Video tour of {{ listing.address }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    </div>
  </div>
  {% endif %}

  {% if listing.zillowUrl or listing.redfinUrl %}
  <div class="listing-detail__external-links">
    <h2 data-i18n="listingdetail.alsoListedOn">Also Listed On</h2>
    <div class="listing-detail__external-links-list">
      {% if listing.zillowUrl %}
      <a href="{{ listing.zillowUrl }}" target="_blank" rel="noopener noreferrer"><span data-i18n="listingdetail.viewOnZillow">View on Zillow</span> <span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if listing.redfinUrl %}
      <a href="{{ listing.redfinUrl }}" target="_blank" rel="noopener noreferrer"><span data-i18n="listingdetail.viewOnRedfin">View on Redfin</span> <span aria-hidden="true">↗</span></a>
      {% endif %}
    </div>
  </div>
  {% endif %}

  {% include "components/tour-form.njk" %}

  {% if listing.address %}
  {% set mapQuery = listing.address + ", " + listing.location %}
  {% include "components/map-embed.njk" %}
  {% endif %}

  {% set mcHeading = "Estimate Your Payment" %}
  {% set mcStartingPrice = listing.price %}
  {% include "components/mortgage-calc.njk" %}

  <div class="cta-banner">
    <div>
      <h2 data-i18n="listingdetail.homeworthCtaHeading">Curious what your home is worth?</h2>
      <p data-i18n="listingdetail.homeworthCtaText">Get a free, no-obligation estimate any time.</p>
    </div>
    <a href="/home-value/" class="cta-banner__button" data-i18n="howihelp.homeworthButton">What's My Home Worth? →</a>
  </div>

  {% include "components/listing-inquiry-form.njk" %}

  {% if similar.length %}
  <div class="listing-detail__similar">
    <h2 data-i18n="listingdetail.similarProperties">Similar Properties</h2>
    <div class="listings-grid">
      {% for other in similar %}
      {% set otherSlug = other.address | slugify %}
      <div class="listing-card" data-slug="{{ otherSlug }}">
        <a class="listing-card__link" href="/listings/{{ otherSlug }}/" aria-label="View details for {{ other.address }}"></a>
        <div class="listing-card__media">
          {% if other.image %}
          <img src="{{ other.image }}" alt="{{ other.address }}" loading="lazy" decoding="async">
          {% else %}
          {{ listingPlaceholder(loop.index0) }}
          {% endif %}
          <span class="listing-card__status listing-card__status--{{ other.status | slugify }}" data-i18n="status.{{ other.status | slugify }}">{{ other.status }}</span>
          {% if other.isSample %}<span class="listing-card__sample" data-i18n="listings.sampleBadge">Sample</span>{% endif %}
        </div>
        <div class="listing-card__body">
          <p class="listing-card__price">{{ other.price }}</p>
          <h3>{{ other.address }}</h3>
          <p class="listing-card__stats">{{ other.beds }} bed · {{ other.baths }} bath · {{ other.sqft }} sqft</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</div>

<div class="lightbox" id="lightbox" hidden>
  <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close">&times;</button>
  <button type="button" class="lightbox__prev" data-lightbox-prev aria-label="Previous photo">&larr;</button>
  <img class="lightbox__img" id="lightbox-img" src="" alt="">
  <button type="button" class="lightbox__next" data-lightbox-next aria-label="Next photo">&rarr;</button>
</div>

<script type="application/ld+json">{{ listing | listingSchema(siteUrl, slug) | safe }}</script>
<script type="application/ld+json">{{ crumbs | breadcrumbSchema(siteUrl) | safe }}</script>
