---
pagination:
  data: listings.list
  size: 1
  alias: listing
permalink: "/listings/{{ listing.address | slugify }}/"
eleventyExcludeFromCollections: true
layout: layouts/page.njk
eleventyComputed:
  title: "{{ listing.address }}"
  description: "{{ listing.blurb }}"
---
{% from "macros/listing-placeholder.njk" import listingPlaceholder %}
{% set slug = listing.address | slugify %}
<div class="listing-detail wrapper">
  <p class="listing-detail__back"><a href="/listings/">← All listings</a></p>

  {% if listing.isSample %}
  <p class="sample-banner">This is a sample listing for demonstration — not a real property for sale. <a href="/contact/">Contact Julia</a> for current listings.</p>
  {% endif %}

  <div class="listing-detail__media">
    {% if listing.image %}
    <img src="{{ listing.image }}" alt="{{ listing.address }}">
    {% else %}
    {{ listingPlaceholder(pagination.pageNumber) }}
    {% endif %}
    <span class="listing-card__status listing-card__status--{{ listing.status | slugify }}">{{ listing.status }}</span>
  </div>

  <div class="listing-detail__header">
    <div class="listing-detail__header-row">
      <p class="listing-detail__price">{{ listing.price }}</p>
      <button type="button" class="listing-card__save listing-card__save--detail" data-save-toggle data-slug="{{ slug }}" data-label="{{ listing.address }}" aria-pressed="false">
        {% include "components/star-icon.njk" %}
        <span>Save</span>
      </button>
    </div>
    <h1>{{ listing.address }}</h1>
    <p class="listing-detail__location">{{ listing.location }}</p>
  </div>

  <dl class="listing-detail__stats">
    <div><dt>Beds</dt><dd>{{ listing.beds }}</dd></div>
    <div><dt>Baths</dt><dd>{{ listing.baths }}</dd></div>
    <div><dt>Sqft</dt><dd>{{ listing.sqft }}</dd></div>
    {% if listing.yearBuilt %}<div><dt>Year Built</dt><dd>{{ listing.yearBuilt }}</dd></div>{% endif %}
    {% if listing.lotSize %}<div><dt>Lot Size</dt><dd>{{ listing.lotSize }}</dd></div>{% endif %}
  </dl>

  {% if listing.description %}
  <p class="listing-detail__description">{{ listing.description | safe }}</p>
  {% endif %}

  {% if listing.features and listing.features.length %}
  <div class="listing-detail__features">
    <h2>Features</h2>
    <ul>
      {% for feature in listing.features %}
      <li>{{ feature }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  <div class="mortgage-calc" id="mortgage-calc" data-price="{{ listing.price }}">
    <h2>Estimate Your Payment</h2>
    <div class="mortgage-calc__grid">
      <label class="mortgage-calc__field">
        Home price
        <input type="number" id="mc-price" min="0" step="1000" inputmode="numeric">
      </label>
      <label class="mortgage-calc__field">
        Down payment (%)
        <input type="number" id="mc-down" min="0" max="100" step="1" value="20" inputmode="numeric">
      </label>
      <label class="mortgage-calc__field">
        Interest rate (%)
        <input type="number" id="mc-rate" min="0" max="20" step="0.1" value="6.5" inputmode="decimal">
      </label>
      <label class="mortgage-calc__field">
        Loan term
        <select id="mc-term">
          <option value="30" selected>30 years</option>
          <option value="15">15 years</option>
        </select>
      </label>
    </div>
    <div class="mortgage-calc__result">
      <p class="mortgage-calc__result-label">Estimated monthly payment</p>
      <p class="mortgage-calc__amount" id="mc-result">$0 / mo</p>
      <p class="mortgage-calc__note">Principal &amp; interest only — excludes taxes, insurance, and HOA dues. This is an estimate for illustration, not a loan offer; contact a lender for actual terms.</p>
    </div>
  </div>

  <p class="listing-detail__cta"><a href="/contact/">Ask Julia about this property →</a></p>
</div>
<script type="application/ld+json">{{ listing | listingSchema(siteUrl, slug) | safe }}</script>
