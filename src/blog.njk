---
layout: layouts/page.njk
title: Blog
titleKey: nav.blog
permalink: /blog/
---
<div class="wrapper">
  <h1 data-i18n="nav.blog">Blog</h1>
  <ul class="post-list">
    {% for post in collections.posts | reverse %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a><br>
      <time datetime="{{ post.date | htmlDateString }}" data-i18n-date>{{ post.date | readableDate }}</time>
    </li>
    {% endfor %}
  </ul>
</div>
